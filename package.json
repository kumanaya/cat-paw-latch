{
  "name": "domo-ts",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "dev": "npm run --workspace @domo/desktop dev",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12",
    "camoufox-js": "^0.12.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true,
    "esbuild": true,
    "better-sqlite3": true,
    "@domo/native-linuxsandbox": true,
    "@domo/native-keychain": true,
    "@domo/native-wincred": true,
    "@domo/native-winsandbox": true,
    "@domo/native-fs": true,
    "@domo/native-hello": true,
    "@domo/native-permissions": true,
    "@domo/native-credential-import": true
  }
}
